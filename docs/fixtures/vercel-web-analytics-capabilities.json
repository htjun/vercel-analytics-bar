{
  "schemaVersion": 1,
  "verifiedAt": "2026-08-02",
  "containsAccountData": false,
  "privateDashboardEndpointsUsed": false,
  "discovery": {
    "currentUser": "available",
    "personalProjects": "nonempty",
    "teamProjects": "nonempty",
    "paginationContract": "pagination.next",
    "livePaginationCursorObserved": false
  },
  "analytics": {
    "metrics": [
      "visitors",
      "pageviews"
    ],
    "bounceRate": "unsupported",
    "analyticsEnabledProjectField": "unknown",
    "productionIsDefault": true,
    "explicitProductionMatchedDefault": true,
    "comparisonMode": "query-previous-window"
  },
  "ranges": {
    "last24Hours": {
      "countBoundary": "utc-day",
      "aggregateGranularity": "hour",
      "observedAggregateRows": 25
    },
    "last7Days": {
      "countBoundary": "utc-day",
      "aggregateGranularity": "day",
      "observedAggregateRows": 8
    },
    "last30Days": {
      "countBoundary": "utc-day",
      "aggregateGranularity": "day",
      "observedAggregateRows": 31
    }
  },
  "errors": {
    "invalidToken": {
      "status": 403,
      "code": "forbidden"
    },
    "rateLimitHeadersObserved": [
      "x-ratelimit-limit",
      "x-ratelimit-remaining",
      "x-ratelimit-reset"
    ],
    "retryAfterSupported": true,
    "rateLimitAndServerErrorsIntentionallyInduced": false
  }
}
