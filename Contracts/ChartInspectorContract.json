{
  "protocol": {
    "version": 1,
    "revisions": {
      "nativeMinimum": 0,
      "styleChangeMinimum": 1,
      "maximum": 1000000000
    },
    "sources": {
      "web": "chart-inspector",
      "native": "vercel-analytics-bar"
    },
    "messages": {
      "nativeState": "state",
      "webIncoming": [
        "copyStyle",
        "ready",
        "reset",
        "styleChanged"
      ]
    }
  },
  "style": {
    "color": {
      "accent": "accent",
      "hexPattern": "^#[0-9A-Fa-f]{6}$",
      "canonicalHexCase": "upper"
    },
    "enums": {
      "lineCap": [
        "butt",
        "round",
        "square"
      ],
      "lineJoin": [
        "miter",
        "round",
        "bevel"
      ]
    },
    "fields": [
      {
        "name": "lineColor",
        "type": "color",
        "default": "#02C06C",
        "inspector": {
          "group": "line",
          "key": "color",
          "control": "color",
          "accentDisplay": "#007AFF"
        }
      },
      {
        "name": "lineWidth",
        "type": "number",
        "default": 1,
        "minimum": 0.5,
        "maximum": 12,
        "step": 0.5,
        "inspector": {
          "group": "line",
          "key": "width",
          "control": "range"
        }
      },
      {
        "name": "lineCap",
        "type": "enum",
        "enum": "lineCap",
        "default": "round",
        "inspector": {
          "group": "line",
          "key": "cap",
          "control": "select"
        }
      },
      {
        "name": "lineJoin",
        "type": "enum",
        "enum": "lineJoin",
        "default": "round",
        "inspector": {
          "group": "line",
          "key": "join",
          "control": "select"
        }
      },
      {
        "name": "areaTopOpacity",
        "type": "number",
        "default": 0.2,
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "inspector": {
          "group": "area",
          "key": "topOpacity",
          "control": "range"
        }
      },
      {
        "name": "areaBottomOpacity",
        "type": "number",
        "default": 0,
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "inspector": {
          "group": "area",
          "key": "bottomOpacity",
          "control": "range"
        }
      },
      {
        "name": "chartHeight",
        "type": "number",
        "default": 140,
        "minimum": 80,
        "maximum": 360,
        "step": 1,
        "inspector": {
          "group": "layout",
          "key": "height",
          "control": "range"
        }
      },
      {
        "name": "axisMarkCount",
        "type": "integer",
        "default": 3,
        "minimum": 2,
        "maximum": 12,
        "step": 1,
        "inspector": {
          "group": "axes",
          "key": "markCount",
          "control": "range"
        }
      },
      {
        "name": "yScaleHeadroom",
        "type": "number",
        "default": 0.1,
        "minimum": 0,
        "maximum": 1,
        "step": 0.01,
        "inspector": {
          "group": "axes",
          "key": "yScaleHeadroom",
          "control": "range"
        }
      },
      {
        "name": "showsGridLines",
        "type": "boolean",
        "default": true,
        "inspector": {
          "group": "axes",
          "key": "gridLines",
          "control": "boolean"
        }
      },
      {
        "name": "showsXAxisLabels",
        "type": "boolean",
        "default": true,
        "inspector": {
          "group": "axes",
          "key": "xLabels",
          "control": "boolean"
        }
      },
      {
        "name": "showsYAxisLabels",
        "type": "boolean",
        "default": true,
        "inspector": {
          "group": "axes",
          "key": "yLabels",
          "control": "boolean"
        }
      }
    ]
  }
}
